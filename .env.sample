# ============================================================
# .env.sample — template cho .env.production
#
# HƯỚNG DẪN:
#   1. cp .env.sample .env.production
#   2. Điền các giá trị marked [REQUIRED]
#   3. Sinh random keys marked [AUTO]:
#        openssl rand -hex 32                        # SECRET_KEY, UTILS_SECRET, CLIPROXY_*, PIPELINE_API_KEY
#        python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"   # CREDENTIAL_ENCRYPTION_KEY
#   4. Copy GCS service account JSON → ./gcs-credentials.json
#   5. docker compose up -d --build
# ============================================================

NODE_ENV=production
ASPNETCORE_ENVIRONMENT=Production

# ────────────────────────────────────────────────────────────
# [REQUIRED] Application URL — domain chính của app
# Vd: https://outline.example.com
# ────────────────────────────────────────────────────────────
URL=https://your-domain.example.com

# ────────────────────────────────────────────────────────────
# Database (PostgreSQL) — KHÔNG cần sửa nếu dùng postgres trong compose
# Các host connection sẽ được docker-compose override sang service name
# ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/outline
PGSSLMODE=disable
DATABASE_SSL=false
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DATABASE=outline

# ────────────────────────────────────────────────────────────
# Redis — KHÔNG cần sửa
# ────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ────────────────────────────────────────────────────────────
# [AUTO] Secret keys — chạy `openssl rand -hex 32` để sinh
# INTERNAL_API_SECRET: shared secret Node ↔ Python backend
#   (dùng trong header X-Internal-Secret cho kanban/chat/graph/badashboard)
# ────────────────────────────────────────────────────────────
SECRET_KEY=
UTILS_SECRET=
INTERNAL_API_SECRET=

# ────────────────────────────────────────────────────────────
# File storage — GCS
# ────────────────────────────────────────────────────────────
FILE_STORAGE=gcs
FILE_STORAGE_LOCAL_ROOT_DIR=./data
FILE_STORAGE_UPLOAD_MAX_SIZE=26214400
FILE_STORAGE_ORPHAN_CLEANUP_HOURS=720

# [REQUIRED] Google Cloud Storage — file ./gcs-credentials.json phải tồn tại
GCS_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-gcs-bucket-name
GCS_KEY_FILE_PATH=./gcs-credentials.json

FORCE_HTTPS=false
DEVELOPMENT_UNSAFE_INLINE_CSP=false

# ────────────────────────────────────────────────────────────
# [REQUIRED] Google OAuth — https://console.cloud.google.com/apis/credentials
# ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ────────────────────────────────────────────────────────────
# [REQUIRED] SMTP — Gmail app password: https://myaccount.google.com/apppasswords
# ────────────────────────────────────────────────────────────
SMTP_SERVICE=gmail
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ────────────────────────────────────────────────────────────
# [REQUIRED] LLM (Gemini) — https://aistudio.google.com/apikey
# ────────────────────────────────────────────────────────────
GEMINI_API_KEY=
LLM_BINDING=gemini
LLM_MODEL=gemini-2.5-flash
LLM_BINDING_HOST=https://generativelanguage.googleapis.com/v1beta/openai
LLM_BINDING_API_KEY=${GEMINI_API_KEY}
USE_CUSTOM_ENTITY_PROMPT=true

# ────────────────────────────────────────────────────────────
# [REQUIRED] Embedding (OpenRouter) — https://openrouter.ai/keys
# ────────────────────────────────────────────────────────────
EMBEDDING_BINDING=openai
EMBEDDING_MODEL=baai/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_TOKEN_LIMIT=8192
EMBEDDING_BINDING_HOST=https://openrouter.ai/api/v1
EMBEDDING_BINDING_API_KEY=

# ────────────────────────────────────────────────────────────
# Neo4j — KHÔNG cần sửa
# ────────────────────────────────────────────────────────────
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4jpass
NEO4J_DATABASE=neo4j

# ────────────────────────────────────────────────────────────
# FileSplit API — thay "your-domain.example.com" bằng domain thực
# ────────────────────────────────────────────────────────────
FILE_SPLIT_API_PORT=5000
VITE_FILE_SPLIT_API_URL=https://your-domain.example.com/filesplit-api
VITE_BACKEND_URL=https://your-domain.example.com/backend
FILE_SPLIT_API_ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.example.com
FILE_SPLIT_API_MAX_FILE_SIZE=52428800

# ────────────────────────────────────────────────────────────
# Claude + CLIProxyAPI
# [AUTO] CLIPROXY_API_KEY, CLIPROXY_MANAGEMENT_KEY — sinh bằng openssl rand -hex 32
# [AUTO] CREDENTIAL_ENCRYPTION_KEY — sinh bằng python3 Fernet (xem đầu file)
# ────────────────────────────────────────────────────────────
CLAUDE_MODEL=claude-sonnet-4-6
CREDENTIAL_ENCRYPTION_KEY=
CLIPROXY_BASE_URL=http://cliproxyapi:8317
CLIPROXY_API_KEY=
CLIPROXY_MANAGEMENT_KEY=

# ────────────────────────────────────────────────────────────
# Pipeline + RabbitMQ
# [AUTO] PIPELINE_API_KEY — sinh bằng: echo "ol_api_$(openssl rand -hex 20)"
# ────────────────────────────────────────────────────────────
PIPELINE_API_KEY=
PIPELINE_CRED_PATH=/root/.claude/.credentials.json
PIPELINE_CREDENTIALS_JSON=

MESSAGE_BROKER_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ────────────────────────────────────────────────────────────
# CORS (Python FastAPI backend)
# ────────────────────────────────────────────────────────────
CORS_ORIGIN=https://your-domain.example.com
CORS_ORIGIN_REGEX=^https://([\w-]+\.)?your-domain\.example\.com$

# ────────────────────────────────────────────────────────────
# GitNexus auto-pull — tự git pull + re-analyze repo đã register định kỳ
#   ENABLED=true  → bật auto-pull
#   INTERVAL      → chu kỳ tính bằng phút (default: 30)
# Repo phải được register qua UI hoặc POST /api/repos/register trước.
# ────────────────────────────────────────────────────────────
GITNEXUS_AUTO_PULL_ENABLED=false
GITNEXUS_AUTO_PULL_INTERVAL_MINUTES=30

# ────────────────────────────────────────────────────────────
# Misc
# ────────────────────────────────────────────────────────────
REQUEST_TIMEOUT=900000
LOG_LEVEL=info
