###############################################################################
### PR Webhook Module — Environment Variables
###############################################################################
###
### Docker (recommended):
###   Inject from .env.local at project root via docker-compose.
###
### Local (no Docker):
###   1. pip install -r requirements.txt
###   2. Copy this file to .env and fill in values
###   3. Start RabbitMQ: docker compose up -d outline-gapfinding-rabbitmq
###   4. Start worker:   python -m pr_webhook_module.workers.run_worker
###   5. Start API:      uvicorn pr_webhook_module.app:app --port 8011
###   6. Configure GitHub webhook: Payload URL + webhookSecret (per-repo)
###
###############################################################################

###############################################################################
### Outline connection (service discovery + auth)
###############################################################################

### Outline server URL — used to push logs + bootstrap config fetch
OUTLINE_URL=http://localhost:3000

### API key for internal pipeline endpoints (badashboard.pushClaudeLogs, etc.)
PIPELINE_API_KEY=your_pipeline_api_key_here

###############################################################################
### Gap-finding module own DB
###############################################################################

### Postgres connection string for gap-finding module's own github_configs table.
### In Docker this points to the shared outline-postgres instance, separate DB.
### Tables are created automatically on startup (no migration tool needed).
GAPFINDING_DATABASE_URL=postgresql://user:pass@localhost:5432/gapfinding

###############################################################################
### GitHub (local dev fallback only)
###############################################################################

### Global webhook secret — fallback when DB has no per-repo secret configured.
### In production, configure webhookSecret per-repo via the GitHub Config UI.
GITHUB_WEBHOOK_SECRET=

### Claude working directory (local dev only — Docker always uses /data/repos)
CLAUDE_PROJECT_DIR=

### GitHub API base URL (change for GitHub Enterprise)
GITHUB_API_URL=https://api.github.com

###############################################################################
### Celery / RabbitMQ
###############################################################################

### Docker: CELERY_BROKER_URL is overridden by docker-compose
### Local:  point to localhost
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=rpc://
CELERY_WORKER_CONCURRENCY=2
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=270

### RabbitMQ credentials
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

###############################################################################
### PR Log Output
###############################################################################

### Docker: /app/pr_logs (mounted to ./pr_logs/ at project root)
PR_LOG_OUTPUT_DIR=./pr_logs

### Max characters of diff to include (~50000 ≈ 12k tokens)
PR_MAX_DIFF_CHARS=50000

### Max characters per source file fetched via code context
PR_MAX_CODE_FILE_CHARS=8000

###############################################################################
### Logging
###############################################################################

LOG_LEVEL=INFO
