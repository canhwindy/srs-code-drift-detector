# ============================================================
# Dockerfile.backend
# Action: CREATE_NEW
# Description: Container cho FastAPI backend với Claude CLI

# Strategy:
#   - Base: python:3.11-slim
#   - Install Node.js + Claude CLI (cần cho claude -p subprocess)
#   - Copy app code + .claude/ directory (CLAUDE.md + skills)
#   - ~/.claude credentials được MOUNT tại runtime (không bake vào image)
#     → Credentials không lộ trong image layers
# ============================================================

FROM python:3.11-slim

# ─────────────────────────────────────────────────────────────
# LAYER 1: System dependencies
# Node.js cần cho Claude CLI (@anthropic-ai/claude-code là npm package)
# ─────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y \
    nodejs \
    npm \
    curl \
    supervisor \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ─────────────────────────────────────────────────────────────
# LAYER 2: Install Claude CLI + gitnexus
# ─────────────────────────────────────────────────────────────
RUN npm install -g @anthropic-ai/claude-code

# Verify Claude CLI
RUN claude --version

# Pre-cache gitnexus via npx (npm install -g fails on npm 10.x due to arborist bug)
RUN echo "legacy-peer-deps=true" >> /root/.npmrc && npx --yes gitnexus --version

# ─────────────────────────────────────────────────────────────
# LAYER 3: Python dependencies
# ─────────────────────────────────────────────────────────────
WORKDIR /app
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# ─────────────────────────────────────────────────────────────
# LAYER 4: Application code + Claude config
# .claude/ chứa CLAUDE.md (base instructions) và skills/
# Skills files được COPY vào image → stable, có thể override bằng volume
# ─────────────────────────────────────────────────────────────
COPY backend/ ./backend/
COPY .claude/ ./.claude/

# Supervisord config — chạy uvicorn + gitnexus eval-server song song
COPY backend/supervisord.conf /etc/supervisor/conf.d/backend.conf

# ─────────────────────────────────────────────────────────────
# LAYER 5: Environment variables
# CLAUDE_WORKING_DIR: Nơi claude subprocess tìm .claude/CLAUDE.md
# LLM_BINDING: Switch sang claude-cli mode
# Các biến còn lại (NEO4J, POSTGRES, v.v.) được truyền từ docker-compose
# ─────────────────────────────────────────────────────────────
ENV CLAUDE_WORKING_DIR=/app
ENV LLM_BINDING=gemini
ENV PYTHONPATH=/app

# ─────────────────────────────────────────────────────────────
# LAYER 6: Start command
# ~/.claude/ credentials được mount tại runtime qua docker-compose volume
# ─────────────────────────────────────────────────────────────
WORKDIR /app
CMD ["supervisord", "-n", "-c", "/etc/supervisor/supervisord.conf"]