# ============================================================
# Dockerfile.filesplit
# .NET 8 container cho FileSplitApi (DOCX/PPTX splitter)
# ============================================================

# ------------------------------------------------------------
# Stage 1: build — SDK + restore + publish
# ------------------------------------------------------------
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build

WORKDIR /src
COPY FileSplitApi/FileSplitApi.csproj FileSplitApi/
RUN dotnet restore FileSplitApi/FileSplitApi.csproj

COPY FileSplitApi/ FileSplitApi/
RUN dotnet publish FileSplitApi/FileSplitApi.csproj -c Release -o /app/publish /p:UseAppHost=false

# ------------------------------------------------------------
# Stage 2: runtime — aspnet runtime only
# ------------------------------------------------------------
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime

WORKDIR /app
COPY --from=build /app/publish ./

ENV ASPNETCORE_ENVIRONMENT=Production
ENV FILE_SPLIT_API_PORT=5000
ENV ASPNETCORE_URLS=http://+:5000

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -qO- "http://localhost:${FILE_SPLIT_API_PORT:-5000}/swagger/index.html" > /dev/null 2>&1 || exit 0

ENTRYPOINT ["dotnet", "FileSplitApi.dll"]
